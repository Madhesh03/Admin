# Copy to .env.local — every value below has a sensible built-in default,
# so this file is optional for local dev (see README "Quick start").

# Mock admin login (src/lib/auth-config.ts). Any seeded demo email + this
# password logs in; see README's role table for the demo emails.
NEXT_PUBLIC_ADMIN_PASSWORD=admin123
NEXT_PUBLIC_ADMIN_EMAIL=owner@sois.in

# Single-tenant deployment id (brief/spec Multi-tenancy -> "sois-store").
NEXT_PUBLIC_TENANT_ID=sois-store

# Real sois-backend API root, used ONLY by the Reviews moderation screen
# (src/lib/real-fetch.ts) — the rest of Admin still runs on mock data.
# Point this at a running `manage.py runserver` (or deployed) sois-backend.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
